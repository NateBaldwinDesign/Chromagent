{
  "name": "chromagentic",
  "version": "0.3.0",
  "description": "Perceptual UI color for AI agents: a color skill plus an engine that generates accessible, mode-aware color systems.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Nate Baldwin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NateBaldwinDesign/Chromagentic.git"
  },
  "homepage": "https://github.com/NateBaldwinDesign/Chromagentic#readme",
  "keywords": [
    "color",
    "accessibility",
    "contrast",
    "wcag",
    "apca",
    "oklch",
    "color-blindness",
    "design-tokens",
    "dark-mode",
    "high-contrast",
    "agent-skills",
    "claude-code-plugin",
    "copilot-plugin",
    "ai",
    "agent"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "chromagentic": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./schema/theme.schema.json": "./skills/chromagentic/assets/theme.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "NOTICE",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "eval": "node --import tsx evals/run.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "gallery": "node --import tsx evals/gallery.ts",
    "version": "node scripts/sync-version.mjs && npm run build && git add .claude-plugin/plugin.json skills/chromagentic README.md"
  },
  "dependencies": {
    "colorjs.io": "^0.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "ajv": "^8.20.0",
    "color-description": "^0.23.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
